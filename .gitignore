# Dependencies
node_modules/

# Build output
dist/

# Credentials and sensitive config.
# 🔴 Match by PATTERN, never by filename. These were two exact names until
# 2026-08-06, when `config/go2rtc.yaml.bak-pre-hksv` and `.bak-pre-srtp` — real
# files on the NAS carrying HomeKit `pairings` and `device_private` — turned out
# to match neither, and so were untracked-but-stageable by `git add -A`.
# The trailing `*` catches backups and any future real yaml; the negation keeps
# the two tracked examples. Same shape as the `.env.*` / `!.env.example` pair.
config/*.yaml*
!config/*.example.yaml
.env
.env.*
!.env.example
secrets/*
!secrets/.gitkeep

# Logs
*.log
docker.log

# OS files
.DS_Store

# IDE
.idea/
.vscode/

# Docker
docker-compose.dev.yml

# Agent scratch: git worktrees and subagent-driven-development workspaces
.claude/worktrees/
.superpowers/

# Generated HomeKit pairing labels — each SVG embeds a setup code, which is
# the pairing secret. `npm run homekit:label` writes here by default.
labels/
*.svg
!docs/**/*.svg
