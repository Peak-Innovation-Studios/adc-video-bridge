.git
.github
.env
.env.*
!.env.example
# Pattern, not filenames — see .gitignore for why (config/*.bak-pre-* carried
# HomeKit secrets and matched neither exact name). Defence in depth: nothing in
# either Dockerfile COPYs config/, so this keeps secrets out of the build
# CONTEXT sent to the daemon, not out of the image.
config/*.yaml*
!config/*.example.yaml
secrets/
node_modules/
dist/
*.log
docker.log
.DS_Store
.idea/
.vscode/

# Generated HomeKit pairing labels — each SVG embeds a setup code, which is
# the pairing secret. `npm run homekit:label` writes here by default.
labels/
*.svg
!docs/**/*.svg
