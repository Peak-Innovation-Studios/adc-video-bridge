# Alarm.com credentials. For Docker secrets, set ADC_USERNAME_FILE,
# ADC_PASSWORD_FILE, and optionally ADC_MFA_TOKEN_FILE instead.
ADC_USERNAME=
ADC_PASSWORD=
ADC_MFA_TOKEN=

# Protect go2rtc's LAN-facing snapshot API and RTSP stream. Generate unique
# random values; do not reuse the Alarm.com password. All four are required:
# compose refuses to start if any is left blank, because go2rtc installs its
# auth middleware only when the username is non-empty — a blank value would
# publish an unauthenticated API, web UI, snapshot endpoint and RTSP.
GO2RTC_API_USERNAME=adcbridge
GO2RTC_API_PASSWORD=
GO2RTC_RTSP_USERNAME=adcbridge
GO2RTC_RTSP_PASSWORD=

# go2rtc runs in its own container on network_mode: host, separate from this
# bridge's default Docker network - loopback is unreachable either way. Set
# this to the server's real LAN address (e.g. 192.168.1.10), not 127.0.0.1.
ADC_BRIDGE_BIND_ADDRESS=192.168.1.10

# Host port range published for the local RTSP relays - one port per camera
# carrying a `localRtsp` block in config.yaml. Must COVER every
# `localRtsp.listenPort` there; a configured-but-unpublished port produces a
# stream go2rtc reports as offline, with no error logged anywhere. Spare ports
# in the range are harmless. Leave the default unless you changed the ports.
ADC_BRIDGE_RTSP_PORTS=8561-8563

# Numeric owner of the deployment directory. On Linux/Synology, obtain these
# with `id -u` and `id -g` so protected mode-600 files remain readable.
ADC_BRIDGE_UID=1000
ADC_BRIDGE_GID=1000

# Logging
LOG_LEVEL=info
