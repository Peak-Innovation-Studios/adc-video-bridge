# HKSV is not in an official go2rtc release yet (AlexxIT/go2rtc#2130 is open),
# so go2rtc is built from a fork of the PR branch. The upstream digest pin is replaced by
# pinning what is underneath: the toolchain by digest, the source by commit SHA.
# 🔴 REVERT TRIGGER: when #2130 ships, delete this build stage and return to the
# official digest-pinned alexxit/go2rtc image.
#
# Digests resolved via the Docker Hub registry API (no local Docker daemon
# available in this environment):
#   golang:1.24.13-alpine3.22 -> sha256:3641e0d9b931dc4f2f185dcd669c4679670e9277c8166a838ddb98a2d4389cb5
#   alpine:3.22                -> sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce
# Both are the multi-arch OCI image index digest (not a single-platform manifest),
# matching what `FROM ...@sha256:` normally pins and what a non-amd64 NAS needs.
#
# go.mod at the pinned commit requires `go 1.24.0` — golang:1.23-alpine (as
# originally sketched) is too old and would fail the build; 1.24.13-alpine3.22
# is used instead, paired with the alpine:3.22 runtime base below.
FROM golang:1.24.13-alpine3.22@sha256:3641e0d9b931dc4f2f185dcd669c4679670e9277c8166a838ddb98a2d4389cb5 AS build
# 🔑 SOURCE CHANGED 2026-08-25: skrashevich/go2rtc@506cfa7 -> Mo3he/go2rtc@2464e567.
# A DIFFERENT MAINTAINER, so this is a supply-chain change and is recorded as one
# in docs/SECURITY_AUDIT.md rather than treated as a routine pin bump.
#
# The branch is `506cfa7` plus 25 commits and ZERO behind, so nothing is given up.
# Verified locally 2026-08-25 against this exact SHA: builds clean, `go vet` clean,
# HKSV + HAP suites pass, and a package-level diff of the FULL suite against
# 506cfa7 shows zero regressions and two packages fixed.
#
# 🔴 Those two matter, because they fail on the commit this replaces:
#   pkg/hap/tlv8   - separator between repeated tags emitted as 0xff, must be 0x00
#   pkg/hap/camera - the advertised HKSV recording configuration
# `506cfa7` shipped both tests already failing.
#
# ⚠️ go.mod still requires `go 1.24.0`, so the toolchain pin above is unchanged,
# and main.go is still the module-root build target (there is no ./cmd/go2rtc).
# Both re-checked at this SHA, not assumed.
ARG GO2RTC_REF=2464e5670accb715d94fa9c7fb7cc1d2107b466b
RUN apk add --no-cache git && \
    git clone https://github.com/Mo3he/go2rtc /src && \
    git -C /src checkout "$GO2RTC_REF"

# 🔴 THE HAP AUTH EXEMPTION IS NOW IN THE PINNED SOURCE. Do not re-add a local
# patch, and do not "tidy away" the exemption if you meet it upstream.
# Without it native HomeKit CANNOT pair while go2rtc's API authentication is
# enabled: HAP is served on the API listener and the Basic-auth middleware
# answers /pair-setup and /pair-verify with 401, which HAP cannot satisfy. It
# fails late and silently - the accessory registers, advertises over mDNS and
# hands back a valid setup code first.
# Reported by us on AlexxIT/go2rtc#2130 and implemented upstream in Mo3he's
# `6f76ea9a`, which registers hap.PathPairSetup / PathPairVerify through a new
# api.HandleFuncNoAuth. That supersedes patches/go2rtc-hap-auth-exempt.patch.
# Full reasoning: docs/INVARIANTS.md.

# This fork's module root (main.go) is the build target, not ./cmd/go2rtc —
# that path doesn't exist at this commit.
RUN cd /src && CGO_ENABLED=0 GOOS=linux go build -trimpath -o /go2rtc .

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce
# ffmpeg is for the snapshot provider (api/frame.jpeg), NOT for HKSV —
# HKSV muxes fMP4 in-process with zero ffmpeg.
RUN apk add --no-cache ffmpeg curl && \
    addgroup -S app && adduser -S app -G app
COPY --from=build /go2rtc /usr/local/bin/go2rtc
USER app
ENTRYPOINT ["go2rtc", "-config", "/app/config/go2rtc.yaml"]
